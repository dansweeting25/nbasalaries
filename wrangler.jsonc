{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nbasalaries",
  // Most requests are served straight from the static assets. The Worker (src/worker.ts) runs first only for:
  // the two directory pages (query-string filters/sort/paging), the live search API, the contact form.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/teams/", "/wp-json/*", "/wp-admin/*", "/api/*"]
  },
  "observability": { "enabled": true },
  // Contact form submissions (schema in migrations/).
  "d1_databases": [
    { "binding": "DB", "database_name": "nbasalaries", "database_id": "51016e02-7c34-45b1-8bdf-b83711eefccf", "migrations_dir": "migrations" }
  ],
  "vars": {
    "SITE_URL": "https://nbasalaries.com",
    "SITE_NAME": "NBA Salaries",
    "FORM_FROM": "forms@nbasalaries.com"
    // FORM_TO (where enquiries are emailed) is set in the Cloudflare dashboard, not in git.
  }
}
