<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"FAQPage","@id":"https://nbasalaries.com/how-we-use-ai/#faq","isPartOf":{"@id":"https://nbasalaries.com/how-we-use-ai/"},"mainEntity":[{"@type":"Question","name":"Is NBA Salaries written by AI?","acceptedAnswer":{"@type":"Answer","text":"Partly. AI drafts much of the copy from checked data. Dan Sweeting decides how pages are structured, which sources count and what is published."}},{"@type":"Question","name":"Which AI tools does NBA Salaries use?","acceptedAnswer":{"@type":"Answer","text":"Mainly Claude, made by Anthropic, for research, writing and building page templates."}},{"@type":"Question","name":"Can AI see private contract details?","acceptedAnswer":{"@type":"Answer","text":"No. Every figure comes from public reporting and official announcements, and player pages list the sources behind their contracts."}},{"@type":"Question","name":"How do you catch AI mistakes?","acceptedAnswer":{"@type":"Answer","text":"Payroll totals are recalculated from player contracts and checked automatically, roster changes are cross-checked against more than one source, and readers can report errors through the contact form."}},{"@type":"Question","name":"Are any figures calculated rather than reported?","acceptedAnswer":{"@type":"Answer","text":"Yes. Percentages of the salary cap and of a team's payroll are worked out from reported salaries, and net worth is an estimate. The methodology page explains how each one is calculated."}}]}</script>
