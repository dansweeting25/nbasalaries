asis]){const line=document.createElement('div');line.textContent=text;tip.append(line);}tip.hidden=false;const rect=box.getBoundingClientRect(),sr=svg.getBoundingClientRect();const px=event?event.clientX-rect.left:(sr.left-rect.left+x(i)*sr.width/900);tip.style.left=Math.max(8,Math.min(box.clientWidth-tip.offsetWidth-8,px+12))+'px';tip.style.top=Math.max(55,(event?event.clientY-rect.top:100)-tip.offsetHeight-14)+'px';}function point(e){const rect=svg.getBoundingClientRect(),px=(e.clientX-rect.left)*900/rect.width;const i=Math.max(0,Math.min(h.length-1,Math.round((px-70)/770*(h.length-1))));show(i,e);}svg.addEventListener('pointermove',e=>{if(e.pointerType==='mouse')point(e)});svg.addEventListener('click',e=>{pinned=true;point(e)});svg.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'&&!pinned)hideTip()});window.addEventListener('scroll',()=>hideTip(),{passive:true});box.querySelector('.ntf-chart-scroll').addEventListener('scroll',()=>hideTip(),{passive:true});});
const nav=[...document.querySelectorAll('.ntf-sidebar nav a')];const sections=nav.map(a=>document.querySelector(a.getAttribute('href'))).filter(Boolean);let scheduled=false;const highlight=()=>{scheduled=false;let current=sections[0];sections.forEach(s=>{if(s.getBoundingClientRect().top<220)current=s});nav.forEach(a=>a.setAttribute('aria-current',String(a.hash==='#'+current?.id)))};window.addEventListener('scroll',()=>{if(!scheduled){scheduled=true;requestAnimationFrame(highlight)}},{passive:true});highlight();
})();
