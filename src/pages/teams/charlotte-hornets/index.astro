<script is:inline>
(()=>{const data={"name":"Charlotte Hornets","pay":0,"cap":164961000,"tax":200428000,"apron":221686000,"peers":[]};const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n),pct=(a,b)=>(100*a/b).toFixed(2)+'%';
const search=document.querySelector('.ntf-search');search?.addEventListener('input',()=>{let visible=0;document.querySelectorAll('tr[data-player]').forEach(r=>{r.hidden=!r.dataset.player.includes(search.value.trim().toLowerCase());visible+=!r.hidden});document.querySelector('.ntf-empty').hidden=!!visible});
function compare(slug,target){const t=data.peers.find(t=>t.slug===slug);if(!t||!target)return;const d=data.pay-Number(t.payroll);target.textContent=data.name+' carry '+money(Math.abs(d))+' '+(d>=0?'more':'less')+' in active cap payroll than '+t.name+'. '+pct(data.pay,data.cap)+' of the cap versus '+pct(t.payroll,data.cap)+'.';}
document.querySelector('#ntf-compare')?.addEventListener('click',()=>compare(document.querySelector('#ntf-team-choice').value,document.querySelector('#ntf-comparison')));
document.querySelector('#ntf-calculate')?.addEventListener('click',()=>{const input=document.querySelector('#ntf-change'),out=document.querySelector('#ntf-scenario');const change=Number(input.value);if(input.value===''||!Number.isFinite(change)||data.pay+change<0){out.textContent='Enter a change that leaves payroll at zero or above.';return;}const n=data.pay+change;out.textContent='Modelled payroll '+money(n)+'. '+pct(n,data.cap)+' of the cap. '+money(Math.abs(n-data.tax))+' '+(n>=data.tax?'above':'below')+' the tax threshold. '+money(Math.abs(n-data.apron))+' '+(n>=data.apron?'above':'below')+' the second apron before other adjustments.';});
document.querySelectorAll('.ntf-carousel').forEach(box=>{const track=box.querySelector('.ntf-track'),pages=box.querySelector('.ntf-pagination');let stops=[];function active(){const pos=track.scrollLeft;let nearest=0;stops.forEach((v,i)=>{if(Math.abs(v-pos)<Math.abs(stops[nearest]-pos))nearest=i});[...pages.children].forEach((b,i)=>b.setAttribute('aria-current',String(i===nearest)));}function build(){const max=track.scrollWidth-track.clientWidth;stops=[0];for(let v=track.clientWidth;v<max-3;v+=track.clientWidth)stops.push(v);if(max>3)stops.push(max);pages.replaceChildren(...stops.map((s,i)=>{const b=document.createElement('button');b.type='button';b.setAttribute('aria-label','Team carousel page '+(i+1));b.addEventListener('click',()=>track.scrollTo({left:s,behavior:'smooth'}));return b}));active();}box.querySelectorAll('[data-dir]').forEach(b=>b.addEventListener('click',()=>track.scrollBy({left:Number(b.dataset.dir)*track.clientWidth,behavior:'smooth'})));box.querySelectorAll('[data-compare]').forEach(b=>b.addEventListener('click',()=>compare(b.dataset.compare,box.querySelector('.ntf-peer-result'))));track.addEventListener('scroll',active,{passive:true});new ResizeObserver(build).observe(track);build();});

const ns='http://www.w3.org/2000/svg';document.querySelectorAll('.ntf-chart').forEach(box=>{const h=JSON.parse(box.dataset.history),svg=box.querySelector('svg'),tip=box.querySelector('.ntf-tooltip');if(!h.length)return;const max=Math.ceil(Math.max(...h.flatMap(r=>[Number(r.payroll),Number(r.cap)]))/50000000)*50000000;const x=i=>70+i*770/Math.max(1,h.length-1),y=v=>305-v/max*255;function el(tag,attrs,text){const n=document.createElementNS(ns,tag);for(const[k,v]of Object.entries(attrs))n.setAttribute(k,v);if(text!==undefined)n.textContent=text;svg.append(n);return n;}for(let i=0;i<=5;i++){const v=max*i/5;el('line',{x1:70,x2:850,y1:y(v),y2:y(v),stroke:'#dadde2'});el('text',{x:55,y:y(v)+4,'text-anchor':'end',fill:'#667085','font-size':13},'$'+v/1000000+'M');}const accent=getComputedStyle(box).getPropertyValue('--ntf-accent').trim();['cap','payroll'].forEach(k=>el('polyline',{points:h.map((r,i)=>x(i)+','+y(r[k])).join(' '),fill:'none',stroke:k==='cap'?'#888':accent,'stroke-width':k==='cap'?2:4,'stroke-dasharray':k==='cap'?'7 5':'none'}));h.forEach((r,i)=>{el('text',{x:x(i),y:338,'text-anchor':'middle',fill:'#555','font-size':13},r.season);const dot=el('circle',{cx:x(i),cy:y(r.payroll),r:7,fill:accent,stroke:'#fff','stroke-width':3,tabindex:0,role:'button','aria-label':r.season+' payroll '+money(r.payroll)});dot.addEventListener('focus',()=>show(i));dot.addEventListener('keydown',e=>{if(e.key==='Escape')hideTip();if(e.key==='Enter'||e.key===' '){e.preventDefault();pinned=true;show(i)}});});let pinned=false;function hideTip(){pinned=false;tip.hidden=true;svg.querySelectorAll('circle').forEach(d=>d.classList.remove('is-active'));}function show(i,event){svg.querySelectorAll('circle').forEach((d,j)=>d.classList.toggle('is-active',i===j));const r=h[i];tip.replaceChildren();const title=document.createElement('b');title.textContent=r.season;tip.append(title);for(const text of [data.name,'Cap Payroll '+money(r.payroll),'League Cap '+money(r.cap),pct(r.payroll,r.cap)+' Of Cap',r.basis]){const line=document.createElement('div');line.textContent=text;tip.append(line);}tip.hidden=false;const rect=box.getBoundingClientRect(),sr=svg.getBoundingClientRect();const px=event?event.clientX-rect.left:(sr.left-rect.left+x(i)*sr.width/900);tip.style.left=Math.max(8,Math.min(box.clientWidth-tip.offsetWidth-8,px+12))+'px';tip.style.top=Math.max(55,(event?event.clientY-rect.top:100)-tip.offsetHeight-14)+'px';}function point(e){const rect=svg.getBoundingClientRect(),px=(e.clientX-rect.left)*900/rect.width;const i=Math.max(0,Math.min(h.length-1,Math.round((px-70)/770*(h.length-1))));show(i,e);}svg.addEventListener('pointermove',e=>{if(e.pointerType==='mouse')point(e)});svg.addEventListener('click',e=>{pinned=true;point(e)});svg.addEventListener('pointerleave',e=>{if(e.pointerType==='mouse'&&!pinned)hideTip()});window.addEventListener('scroll',()=>hideTip(),{passive:true});box.querySelector('.ntf-chart-scroll').addEventListener('scroll',()=>hideTip(),{passive:true});});
const nav=[...document.querySelectorAll('.ntf-sidebar nav a')];const sections=nav.map(a=>document.querySelector(a.getAttribute('href'))).filter(Boolean);let scheduled=false;const highlight=()=>{scheduled=false;let current=sections[0];sections.forEach(s=>{if(s.getBoundingClientRect().top<220)current=s});nav.forEach(a=>a.setAttribute('aria-current',String(a.hash==='#'+current?.id)))};window.addEventListener('scroll',()=>{if(!scheduled){scheduled=true;requestAnimationFrame(highlight)}},{passive:true});highlight();
})();
