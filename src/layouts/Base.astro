<style is:inline>#nba-reading-progress{position:fixed;top:0;left:0;width:100%;height:6px;background:#dedede;z-index:100000;pointer-events:none}#nba-reading-progress>span{display:block;width:100%;height:100%;background:#1d428a;transform:scaleX(0);transform-origin:left}.admin-bar #nba-reading-progress{top:32px}@media(max-width:782px){.admin-bar #nba-reading-progress{top:46px}}@media(max-width:600px){.admin-bar #nba-reading-progress{top:0}}</style>
<script is:inline>(()=>{const bar=document.getElementById('nba-reading-progress'),fill=bar.firstElementChild;let pending=false;const update=()=>{pending=false;const total=document.documentElement.scrollHeight-innerHeight;const value=total>0?Math.max(0,Math.min(1,scrollY/total)):0;fill.style.transform='scaleX('+value+')';bar.setAttribute('aria-valuenow',Math.round(value*100));};const queue=()=>{if(!pending){pending=true;requestAnimationFrame(update);}};addEventListener('scroll',queue,{passive:true});addEventListener('resize',queue);new ResizeObserver(queue).observe(document.body);update();})();</script>
<script is:inline>(()=>{const button=document.querySelector('.bde-button-365-108 .button-atom'),header=document.querySelector('#nba-site-header');if(!button||!header)return;const sync=()=>{const c=getComputedStyle(button);header.style.setProperty('--nba-header-button-height',button.getBoundingClientRect().height+'px');header.style.setProperty('--nba-header-button-radius',c.borderRadius)};new ResizeObserver(sync).observe(button);sync();})();</script>
<script is:inline>(()=>{document.querySelectorAll('.nf-carousel-actions').forEach(row=>{const cta=row.querySelector('.nf-carousel-cta');if(!cta)return;const sync=()=>row.style.setProperty('--nf-control-height',cta.getBoundingClientRect().height+'px');new ResizeObserver(sync).observe(cta);sync();});})();</script>
<script is:inline>(()=>{document.querySelectorAll('meta[name="theme-color"]').forEach(m=>m.content='#ffffff');document.querySelectorAll('#overview,.ntf-mobile-pills').forEach(hero=>{const accent=getComputedStyle(hero).getPropertyValue('--nba-team-accent').trim()||'#1d428a';const probe=document.createElement('span');probe.style.color=accent;hero.append(probe);const rgb=getComputedStyle(probe).color.match(/[\d.]+/g)?.slice(0,3).map(Number);probe.remove();if(!rgb)return;const mix=rgb.map(v=>Math.round(v*.8+255*.2));const linear=mix.map(v=>{v/=255;return v<=.04045?v/12.92:((v+.055)/1.055)**2.4;});const lum=linear[0]*.2126+linear[1]*.7152+linear[2]*.0722;hero.style.setProperty('--nba-pill-bg',`rgb(${mix.join(',')})`);hero.style.setProperty('--nba-pill-ink',lum>.179?'#101820':'#ffffff');});})();</script>
